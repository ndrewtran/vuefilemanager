{
    "name": "laravel/laravel",
    "type": "project",
    "description": "The Laravel Framework.",
    "keywords": [
        "framework",
        "laravel"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "ext-json": "*",
        "ext-pdo": "*",
        "ext-zip": "*",
        "azure-oss/storage-blob-laravel": "^1.7",
        "cocur/slugify": "^4.7.1",
        "doctrine/dbal": "^4.4.4",
        "gabrielelana/byte-units": "^0.5.0",
        "guzzlehttp/guzzle": "^7.11.1",
        "intervention/image": "^2.7.1",
        "jaybizzle/laravel-crawler-detect": "^1.2",
        "kyslik/column-sortable": "^8.0",
        "laravel/fortify": "^1.38",
        "laravel/framework": "^12.62",
        "laravel/reverb": "^1.11",
        "laravel/sanctum": "^4.3.3",
        "laravel/socialite": "^5.30",
        "laravel/tinker": "^2.11.1",
        "laravel/ui": "^4.6",
        "league/flysystem-aws-s3-v3": "^3.35.3",
        "league/flysystem-ftp": "^3.35.3",
        "makingcg/saas-billing": "^1.0",
        "pusher/pusher-php-server": "^7.3",
        "spatie/laravel-backup": "^10.3.2",
        "spatie/laravel-query-builder": "^7.3.3",
        "spatie/laravel-queueable-action": "^2.17",
        "spatie/laravel-tail": "^4.6",
        "symfony/http-client": "^7.4.17 || ^8.0",
        "symfony/mailgun-mailer": "^7.4.16 || ^8.0",
        "symfony/postmark-mailer": "^7.4 || ^8.0",
        "teamtnt/laravel-scout-tntsearch-driver": "^15.0",
        "vimeo/psalm": "^6.16.1"
    },
    "require-dev": {
        "barryvdh/laravel-ide-helper": "^3.6",
        "brianium/paratest": "7.8.*",
        "friendsofphp/php-cs-fixer": "^3.95.21",
        "spatie/laravel-ignition": "^2.12",
        "larastan/larastan": "^3.10",
        "nunomaduro/collision": "^8.8",
        "phpunit/phpunit": "^11.5.55",
        "mockery/mockery": "^1.6.15",
        "fakerphp/faker": "^1.24"
    },
    "repositories":[
        {
            "type": "path",
            "url": "packages/saas-billing",
            "options": {
                "symlink": false
            }
        }
    ],
    "config": {
        "optimize-autoloader": true,
        "platform": {
            "php": "8.3.16"
        },
        "preferred-install": "dist",
        "sort-packages": true,
        "github-protocols": ["https"]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "autoload": {
        "psr-4": {
            "App\\" : "src/App/",
            "Domain\\" : "src/Domain/",
            "Support\\" : "src/Support/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        },
        "classmap": [
            "database/seeds",
            "database/factories"
        ],
        "files": [
            "src/Support/errors.php",
            "src/Support/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ],
        "format": "vendor/bin/php-cs-fixer fix --allow-risky=yes"
    }
}
